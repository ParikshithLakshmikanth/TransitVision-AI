      "data_classification": "DERIVED_FEATURE",
      "is_observed": false
    },
    "is_weekend": {
      "source_file": "derived",
      "source_column": "day_of_week >= 5",
      "transformation": "Weekend binary indicator",
      "data_classification": "DERIVED_FEATURE",
      "is_observed": false
    },
    "is_peak_period": {
      "source_file": "derived",
      "source_column": "hour, minute",
